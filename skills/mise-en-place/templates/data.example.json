{
  "base_url": "https://api.<tool>.com/v1",
  "auth": {
    "env_var": "<TOOL>_TOKEN",
    "header": "Authorization: Bearer $<TOOL>_TOKEN"
  },
  "default_account": "<slug>",
  "accounts": {
    "<slug>": {
      "account_id": "<ACCOUNT_ID>",
      "name": "",
      "currency": "USD",
      "timezone": "America/New_York",
      "pipelines": {
        "<pipeline_id>": {
          "name": "",
          "stages": {
            "<stage_id>": "<stage name>"
          }
        }
      },
      "custom_fields": {
        "<field_id>": {
          "name": "",
          "type": "enum",
          "options": {
            "<enum_id>": "<label>"
          }
        }
      }
    }
  },
  "_validated_at": "YYYY-MM-DD",
  "_notes": "Copy to data.local.json (outside git) and fill in the real IDs. Never put the token here; it lives in the environment variable named in auth.env_var."
}
